# ═══════════════════════════════════════════════════════════
#  CARLA Adapter — Environment Configuration
# ═══════════════════════════════════════════════════════════

# --- CARLA Simulator ---
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_TIMEOUT=10.0

# --- Kafka ---
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=carla-state

# --- Simulation ---
TICK_INTERVAL=0.1
NUM_MOCK_VEHICLES=8

# --- Mode ---
# Set to true to run without CARLA (generates fake data)
MOCK_MODE=true

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8084
